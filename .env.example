# ==============================================================================
# Pipeline Environment Variables & Configuration
# ==============================================================================

# LLM API Keys (Set either GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: 'gemini' or 'openai' (default: gemini)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Configuration
# Target Google Sheet ID (Found in your Google Sheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Path to your Google Cloud Service Account JSON credentials
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Applicant identity used by the apply bot. Leave blank to use the profile in cv.json.
APPLICANT_FULL_NAME=
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
# Phone number kept out of git and off the public site: added only to resumes and emails sent to employers
APPLICANT_PHONE=
APPLICANT_LINKEDIN=
APPLICANT_GITHUB=
APPLICANT_PORTFOLIO=

# Pipeline Runtime Controls
# Set to 'true' for unattended live submission, or 'false' for dry-run verification
AUTO_SUBMIT=false
# Playwright Headless mode ('true' or 'false')
HEADLESS_BROWSER=true
# Directories (relative to project workspace root)
OUTPUT_DIR=output
LOGS_DIR=logs

# ==============================================================================
# Cold Email Outreach (cold_emailer.py)
# ==============================================================================
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Never use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
# Inbox checked for replies so follow-ups stop automatically
IMAP_HOST=imap.gmail.com
# Display name on outgoing mail (defaults to the name in cv.json)
EMAIL_FROM_NAME=

# 'true' = outreach cycles / the daemon send drafts and follow-ups without review
EMAIL_AUTO_SEND=true
# 'true' = write .eml previews to output/emails/ instead of sending. Set 'false' to go live.
EMAIL_DRY_RUN=true
# Guardrails
EMAIL_DAILY_LIMIT=15
EMAIL_FOLLOWUP_DAYS=5
EMAIL_MAX_FOLLOWUPS=1
EMAIL_MIN_DELAY_SECONDS=60
EMAIL_MAX_DELAY_SECONDS=180
