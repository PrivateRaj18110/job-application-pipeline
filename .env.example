# ==============================================================================
# Pipeline Environment Variables & Configuration
# ==============================================================================

# LLM API Keys (Set either GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: 'gemini' or 'openai' (default: gemini)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Configuration
# Target Google Sheet ID (Found in your Google Sheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Path to your Google Cloud Service Account JSON credentials
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Applicant Master Profile Info (Source of truth from Master Resume)
APPLICANT_FULL_NAME=Alex Rivera
APPLICANT_FIRST_NAME=Alex
APPLICANT_LAST_NAME=Rivera
APPLICANT_EMAIL=alex.rivera.dev@example.com
APPLICANT_PHONE=+1-555-0199
APPLICANT_LINKEDIN=https://www.linkedin.com/in/alexrivera-dev
APPLICANT_GITHUB=https://github.com/alexrivera-dev
APPLICANT_PORTFOLIO=https://alexrivera.dev

# Pipeline Runtime Controls
# Set to 'true' for unattended live submission, or 'false' for dry-run verification
AUTO_SUBMIT=false
# Playwright Headless mode ('true' or 'false')
HEADLESS_BROWSER=true
# Directories (relative to project workspace root)
OUTPUT_DIR=output
LOGS_DIR=logs
